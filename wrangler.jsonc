{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "therothacademy",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roth-academy-applications",
      "database_id": "7b4f86ad-e148-4271-9a7e-99344bfa46b6",
      "migrations_dir": "migrations"
    }
  ],
  // Placeholders only — real values are set with `wrangler secret put
  // <NAME>`, which overrides this in production. Locally, set these in a
  // gitignored .dev.vars file instead (wrangler reads it automatically;
  // .env.local is not used for Cloudflare bindings by the installed
  // @opennextjs/cloudflare version). ABANDONED_CHECK_SECRET authorizes the
  // scheduled call to /api/applications/check-abandoned. STRIPE_SECRET_KEY
  // and STRIPE_WEBHOOK_SECRET are test-mode values during development --
  // switch to live-mode values only when going to production.
  "vars": {
    "SSN_ENCRYPTION_KEY": "",
    "ABANDONED_CHECK_SECRET": "",
    "STRIPE_SECRET_KEY": "",
    "STRIPE_WEBHOOK_SECRET": ""
  }
}
